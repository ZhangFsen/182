<!-- 6.23.4 原生冷启动页：图标/名称/标语/署名/版本全部由系统 View 绘制，不再经过 HTML。
     构图与原 HTML 启动层一致：图标组中心钉在屏高 47%（代码里微调），署名区贴底 34dp。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF7100"
    android:forceDarkAllowed="false">

    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/splash_blob1"/>

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="74dp"
        android:layout_marginStart="-104dp"
        android:background="@drawable/splash_blob2"/>

    <LinearLayout
        android:id="@+id/splashInner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
                android:layout_width="95dp"
            android:layout_height="95dp"
            android:contentDescription="秒记账"
            android:src="@drawable/splash_badge"/>

        <TextView
                android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="秒记账"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.0625"/>

        <TextView
                android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="记录每一笔小账"
            android:textColor="#ADFFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.042"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="34dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
                android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZhangFsen"
            android:textColor="#D1FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.018"/>

        <TextView
            android:id="@+id/splashVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="v6.23.3"
            android:textColor="#73FFFFFF"
            android:textSize="10sp"
            android:letterSpacing="0.03"/>
    </LinearLayout>
</FrameLayout>
